# GEMINI_API_KEY: Required for Gemini AI gameplay analysis and Pakistani Urdu TTS.
# Configured via Secrets in AI Studio or environment variables in deployment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# PORT: Server HTTP + WebSocket port (defaults to 3000).
PORT="3000"

# YOUTUBE_API_KEY: Optional public API key for checking public YouTube URL metadata
# when a user has not signed in with Google OAuth.
YOUTUBE_API_KEY=""

# FFMPEG_PATH / FFPROBE_PATH: Optional binary paths if not on system PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# VITE_BACKEND_URL: Optional custom backend base URL when hosting frontend separately.
# Leave empty to use the same origin.
VITE_BACKEND_URL=""
